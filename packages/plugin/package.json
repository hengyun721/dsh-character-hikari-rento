{
  "name": "hikari-rento",
  "version": "1.0.2",
  "description": "恋兔光（《这里是，终末停滞委员会。》）角色模仿插件：把她的口癖、脾气和知识边界作为 agent 人设挂进 DeepSeek Harness 会话。A DeepSeek Harness persona bundle for Rento Hikari.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./character.json": "./character.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "character.json",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "references/*.md",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "character",
    "persona",
    "roleplay",
    "hikari-rento",
    "终末停滞委员会",
    "恋兔光",
    "角色扮演"
  ],
  "license": "MIT",
  "author": "hikari-rento contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hengyun721/hikari-rento.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/hengyun721/hikari-rento/tree/main/packages/plugin#readme",
  "bugs": {
    "url": "https://github.com/hengyun721/hikari-rento/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "scripts": {
    "prepublishOnly": "node ../../scripts/build.mjs --check"
  }
}
