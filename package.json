{
  "name": "dsh-character-hikari-rento",
  "version": "2.0.0",
  "description": "恋兔光（《这里是，终末停滞委员会。》）角色模仿插件：把她的口癖、脾气和知识边界作为 agent 人设挂进 DeepSeek Harness 会话。A DeepSeek Harness persona plugin for Rento Hikari.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./character.json": "./character.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "character.json",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "references/*.md",
    "assets/*.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "恋兔光 · 角色模仿",
    "description": "把《这里是，终末停滞委员会。》的恋兔光作为人设挂进会话：最强美少女的自夸、尾巴上的「～」「♪」「啦」「哦」「呢」，以及逞强、怕烫怕辣怕鬼、把真心藏到最后的笨拙。"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "character",
    "persona",
    "roleplay",
    "hikari-rento",
    "终末停滞委员会",
    "恋兔光",
    "角色扮演"
  ],
  "license": "MIT",
  "author": "dsh-character-hikari-rento contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hengyun721/dsh-character-hikari-rento.git"
  },
  "homepage": "https://github.com/hengyun721/dsh-character-hikari-rento#readme",
  "bugs": {
    "url": "https://github.com/hengyun721/dsh-character-hikari-rento/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --check index.js",
    "test": "node scripts/self-check.mjs",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {}
}
